<ui:FluentWindow x:Class="ArchiveArchiver.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Arşivci" Width="1360" Height="840" MinWidth="720" MinHeight="540"
                 Icon="pack://application:,,,/Assets/app.ico"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Window.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <!-- Under each key in Settings: what its Test button got back; empty (and so no gap) until pressed -->
        <Style x:Key="TestResult" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,4,0,12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Status dot; Tone comes from MediaItem.ToneOf -->
        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="error">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="busy">
                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- List item without the default row chrome; the item template draws its own selection -->
        <Style x:Key="BareItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Arşivci  ·  Film ve Dizi Düzenleyici">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Command bar -->
        <Border Grid.Row="1" Margin="16,0,16,10" Style="{StaticResource Card}">
            <StackPanel x:Name="Commands">
                <UniformGrid x:Name="PathsGrid" Columns="2">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Style="{StaticResource Label}" Text="KAYNAK  ·  dağınık film ve dizi dosyaları" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,7" Click="BrowseSource_Click"
                                       Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Klasör seç" />
                            <ui:TextBox x:Name="SourceBox" PlaceholderText="Örn. E:\İndirilenler" Icon="{ui:SymbolIcon Folder24}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Label}" Text="KÜTÜPHANE  ·  düzenli klasörlerin gideceği yer (boşsa kaynak)" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,7" Click="BrowseLibrary_Click"
                                       Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Klasör seç" />
                            <ui:TextBox x:Name="LibraryBox" PlaceholderText="Örn. E:\Arşiv" Icon="{ui:SymbolIcon Library24}" />
                        </DockPanel>
                    </StackPanel>
                </UniformGrid>

                <DockPanel Margin="0,4,0,0">
                    <ui:Button DockPanel.Dock="Right" Content="Ayarlar" Icon="{ui:SymbolIcon Settings24}" Click="Settings_Click" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                        <RadioButton x:Name="GridViewButton" GroupName="View" IsChecked="True" Padding="10,7" ToolTip="Izgara"
                                     Style="{StaticResource {x:Type ToggleButton}}" Checked="View_Checked">
                            <ui:SymbolIcon Symbol="Grid24" />
                        </RadioButton>
                        <RadioButton GroupName="View" Margin="4,0,0,0" Padding="10,7" ToolTip="Liste"
                                     Style="{StaticResource {x:Type ToggleButton}}" Checked="View_Checked">
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                        </RadioButton>
                    </StackPanel>
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,6" Content="1  Tara" Icon="{ui:SymbolIcon Search24}" Click="Scan_Click"
                                   ToolTip="Kaynak klasördeki videoları bul" />
                        <ui:Button Margin="0,0,8,6" Content="2  Eşleştir" Icon="{ui:SymbolIcon CloudArrowDown24}" Click="Match_Click"
                                   ToolTip="TMDb, OMDb ve Fanart.tv'den bilgileri getir" />
                        <ui:Button Margin="0,0,20,6" Content="3  Uygula" Appearance="Primary" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                   Click="Apply_Click" ToolTip="Taşı, afiş indir, ikon, Bilgi.html ve DVD/Blu-ray kapağı oluştur" />
                        <ui:Button Margin="0,0,8,6" Content="Geri al" Icon="{ui:SymbolIcon ArrowUndo24}" Click="Undo_Click"
                                   ToolTip="Kütüphanedeki son Uygula'yı geri al: dosyalar eski yerine döner" />
                        <ui:Button Margin="0,0,8,6" Content="İkonları yenile" Icon="{ui:SymbolIcon ArrowSync24}" Click="Refresh_Click"
                                   ToolTip="Kütüphanedeki klasörlerin afiş, ikon, Bilgi.html ve DVD/Blu-ray kapağı dosyalarını yeniden oluştur" />
                        <ui:Button Margin="0,0,8,6" Content="Disk hazırla" Icon="{ui:SymbolIcon Album24}" Click="Disc_Click"
                                   ToolTip="Bir klasöre autorun.inf ve afişli menü ekle" />
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- List + details -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Grid view: poster tiles. Shares items and selection with the table below. -->
                    <ListBox x:Name="Tiles" Padding="8" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource BareItem}" SelectionChanged="Tiles_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ui:VirtualizingWrapPanel SpacingMode="Uniform" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Tile" Width="196" Margin="6" Padding="10,8,10,12" CornerRadius="10" BorderThickness="2"
                                        BorderBrush="Transparent" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <!-- The folder icon fills the square edge to edge so its logo can hang over the top-right -->
                                        <Grid Height="172">
                                            <!-- Until the folder icon is ready (or if it can't be drawn): the poster, or a placeholder -->
                                            <Grid x:Name="PosterBox" Width="114" Height="172" Visibility="Collapsed"
                                                  Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Grid.Clip>
                                                    <RectangleGeometry Rect="0,0,114,172" RadiusX="6" RadiusY="6" />
                                                </Grid.Clip>
                                                <ui:SymbolIcon Symbol="Filmstrip24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Image Source="{Binding PosterThumb, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                            </Grid>
                                            <Image Source="{Binding FolderIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" ToolTip="Uygula'ya dahil et"
                                                      MinWidth="0" Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        </Grid>

                                        <!-- Two lines, fixed height: every tile lines up whatever the title length -->
                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Margin="2,10,2,0" Height="40"
                                                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                        <StackPanel Orientation="Horizontal" Margin="2,6,2,0">
                                            <Border Padding="7,2" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Cell}" FontSize="11" Margin="2,6,2,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Border Height="1" Margin="2,10,2,8" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                                        <DockPanel Margin="2,0">
                                            <Ellipse Style="{StaticResource ToneDot}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Cell}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding FolderIcon}" Value="{x:Null}">
                                        <Setter TargetName="PosterBox" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    </DataTrigger>
                                    <!-- after the hover trigger, so a selected tile keeps its accent edge under the mouse -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                    <!-- left out of Apply: dim it so the skipped ones stand out -->
                                    <DataTrigger Binding="{Binding Include}" Value="False">
                                        <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DataGrid x:Name="List" Visibility="Collapsed" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              BorderThickness="0" Background="Transparent" RowHeight="58"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionChanged="List_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="0" Padding="0" HorizontalAlignment="Center" ToolTip="Uygula'ya dahil et" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="32" Height="48" CornerRadius="3" ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{Binding PosterThumb, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Tür" Binding="{Binding KindText}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Eşleşme" Binding="{Binding MatchText}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn x:Name="TargetColumn" Header="Hedef" Binding="{Binding TargetPath}" Width="3*" IsReadOnly="True" ElementStyle="{StaticResource Cell}" />
                            <DataGridTemplateColumn Header="Durum" Width="Auto" MinWidth="110" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Ellipse Style="{StaticResource ToneDot}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Cell}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="Filmstrip24" FontSize="56" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,12,0,0" FontSize="16" HorizontalAlignment="Center" Text="Kaynak klasörü seç ve Tara'ya bas" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Önce hiçbir dosya taşınmaz; her şeyi burada önizleyip onaylarsın." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail pane: right on wide windows, below the list on narrow ones -->
            <Border x:Name="Detail" Grid.Column="1" Width="380" Margin="12,0,0,0" Style="{StaticResource Card}"
                    DataContext="{Binding SelectedItem, ElementName=List}">
                <Grid>
                    <TextBlock x:Name="DetailHint" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Ayrıntı ve yanlış eşleşmeyi düzeltmek için listeden bir dosya seç." />
                    <ScrollViewer x:Name="DetailBody" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid x:Name="DetailGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="DetailPoster" Width="200" Height="300" CornerRadius="8" ClipToBounds="True"
                                    HorizontalAlignment="Center" Margin="0,0,0,14"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding PosterLarge, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel x:Name="DetailInfo" Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock Text="{Binding MatchText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Meta.GenresText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Meta.RatingsText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Meta.Overview}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" />
                                <TextBlock Text="{Binding FileName}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                <!-- Folder icon preview; the arrows pick another image for it -->
                                <DockPanel Margin="0,14,0,0">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Meta}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Image DockPanel.Dock="Left" Width="64" Height="64" Source="{Binding FolderIcon}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Klasör ikonu" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:Button Padding="10,4" Icon="{ui:SymbolIcon ChevronLeft24}" ToolTip="Önceki resim" Click="PrevArt_Click" />
                                            <ui:Button Padding="10,4" Margin="6,0,0,0" Icon="{ui:SymbolIcon ChevronRight24}" ToolTip="Sonraki resim" Click="NextArt_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Separator Margin="0,16" />
                                <TextBlock Text="Eşleşme yanlış mı?" FontWeight="SemiBold" />
                                <TextBlock Text="Adı (istersen yılıyla) yazıp ara, sonra listeden doğrusunu seç. Dizide bütün bölümlere uygulanır."
                                           Margin="0,2,0,8" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Ara" Click="Search_Click" />
                                    <ui:TextBox x:Name="SearchBox" PlaceholderText="Örn. Avatar 2009" KeyDown="SearchBox_KeyDown" />
                                </DockPanel>
                                <ListBox x:Name="CandidatesList" Margin="0,8,0,0" ItemsSource="{Binding Candidates}"
                                         SelectionChanged="Candidate_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Border Width="34" Height="51" CornerRadius="3" ClipToBounds="True" Margin="0,0,10,0"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{Binding PosterThumb, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Overview}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Log: every status message and per-file result of this session -->
        <Border x:Name="LogPanel" Grid.Row="3" Height="150" Margin="16,12,16,0" Padding="4" Style="{StaticResource Card}">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" FontSize="12"
                     ItemContainerStyle="{StaticResource BareItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="10,3">
                            <TextBlock Text="{Binding Time}" FontFamily="Consolas" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Ellipse Style="{StaticResource ToneDot}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Cell}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Margin="16,8,20,10">
            <ui:Button DockPanel.Dock="Left" Margin="0,0,12,0" Padding="8,4" Appearance="Transparent" Content="Günlük"
                       Icon="{ui:SymbolIcon History24}" ToolTip="Günlüğü göster/gizle" Click="LogToggle_Click" />
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="4" Visibility="Collapsed" />
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="Hazır." />
        </DockPanel>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsOverlay" Grid.Row="1" Grid.RowSpan="4" Background="#99000000" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="560" MaxWidth="{Binding ActualWidth, ElementName=SettingsOverlay}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Ayarlar" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Anahtarlar ücretsiz. En az TMDb ya da OMDb gerekli; üçü birlikte en iyi sonucu verir." />

                    <TextBlock Style="{StaticResource Label}">
                        TMDb  ·  v3 API key ya da v4 token  ·
                        <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api" RequestNavigate="Link_Navigate">anahtar al</Hyperlink>
                    </TextBlock>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Test et" Tag="TMDb" Click="TestKey_Click"
                                   Icon="{ui:SymbolIcon PlugConnected24}" ToolTip="Bu anahtarla TMDb'den örnek bir film çek" />
                        <ui:TextBox x:Name="TmdbBox" Icon="{ui:SymbolIcon Key24}" />
                    </DockPanel>
                    <TextBlock x:Name="TmdbResult" Style="{StaticResource TestResult}" />

                    <TextBlock Style="{StaticResource Label}">
                        OMDb  ·  IMDb / Rotten Tomatoes / Metacritic puanları  ·
                        <Hyperlink NavigateUri="https://www.omdbapi.com/apikey.aspx" RequestNavigate="Link_Navigate">anahtar al</Hyperlink>
                    </TextBlock>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Test et" Tag="OMDb" Click="TestKey_Click"
                                   Icon="{ui:SymbolIcon PlugConnected24}" ToolTip="Bu anahtarla OMDb'den örnek bir film çek" />
                        <ui:TextBox x:Name="OmdbBox" Icon="{ui:SymbolIcon Key24}" />
                    </DockPanel>
                    <TextBlock x:Name="OmdbResult" Style="{StaticResource TestResult}" />

                    <TextBlock Style="{StaticResource Label}">
                        Fanart.tv  ·  HD afiş, logo, disk görseli  ·
                        <Hyperlink NavigateUri="https://fanart.tv/get-an-api-key/" RequestNavigate="Link_Navigate">anahtar al</Hyperlink>
                    </TextBlock>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Test et" Tag="Fanart.tv" Click="TestKey_Click"
                                   Icon="{ui:SymbolIcon PlugConnected24}" ToolTip="Bu anahtarla Fanart.tv'den örnek bir filmin görsellerini say" />
                        <ui:TextBox x:Name="FanartBox" Icon="{ui:SymbolIcon Key24}" />
                    </DockPanel>
                    <TextBlock x:Name="FanartResult" Style="{StaticResource TestResult}" />

                    <TextBlock Style="{StaticResource Label}" Text="Bilgi dili" />
                    <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag" Margin="0,0,0,20">
                        <ComboBoxItem Content="Türkçe (yoksa İngilizce)" Tag="tr-TR" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Vazgeç" Margin="0,0,8,0" Click="SettingsCancel_Click" />
                        <ui:Button Content="Kaydet" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="SettingsSave_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
